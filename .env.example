# ---------------------------------------------------------------------------
# FINOVA — variables de entorno (plantilla)
# Copiar a `.env` y rellenar. `.env` NUNCA se versiona.
# Todas estas variables son SERVER-SIDE: no usar el prefijo PUBLIC_.
# ---------------------------------------------------------------------------

# SMTP (envío de formularios). Pendiente de definir el runtime de producción.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Destinatario de los formularios de contacto y del simulador.
CONTACT_TO=info@somosfinova.com

# Remitente que verá el destinatario (debe estar autorizado en el dominio).
CONTACT_FROM=
