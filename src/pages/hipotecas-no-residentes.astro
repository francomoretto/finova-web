---
import Container from '@components/common/Container.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hipotecas para no residentes"
  description="Hipotecas para personas no residentes en España que quieren comprar un inmueble en el país. FINOVA gestiona la operación de principio a fin."
  canonical="/hipotecas-no-residentes/"
>
  <Container as="section" class="section">
    <h1>Hipotecas para no residentes</h1>
    <p class="lead">Compra de vivienda en España sin residencia fiscal en el país.</p>
    <p class="placeholder-note">
      Contenido pendiente de redacción y diseño. Página creada para fijar la ruta y la estructura
      semántica.
    </p>
  </Container>
</BaseLayout>
