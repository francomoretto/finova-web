---
/**
 * Portada — PROVISIONAL.
 *
 * La Home real se desarrolla en la siguiente etapa. Esta versión existe sólo
 * para auditar visualmente el sistema (cabecera, tipografía, contenedor, pie).
 */
import Container from '@components/common/Container.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Broker hipotecario en Oviedo"
  description="FINOVA negocia tu hipoteca con más de una decena de entidades. Intermediario de crédito inmobiliario registrado en el Banco de España (E794)."
  canonical="/"
>
  <Container as="section" class="section">
    <h1>FINOVA</h1>
    <p class="lead">
      La portada se desarrollará en la siguiente etapa. Esta página muestra únicamente el sistema
      visual base: cabecera, contenedor, tipografía y pie.
    </p>
  </Container>
</BaseLayout>
