---
import Container from '@components/common/Container.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Reunificación de deudas"
  description="Agrupa tus préstamos y deudas en una única cuota mensual con garantía hipotecaria. FINOVA estudia tu caso."
  canonical="/reunificacion-deudas/"
>
  <Container as="section" class="section">
    <h1>Reunificación de deudas</h1>
    <p class="lead">Agrupa varios préstamos en una sola cuota mensual.</p>
    <p class="placeholder-note">
      Contenido pendiente de redacción y diseño. Página creada para fijar la ruta y la estructura
      semántica.
    </p>
  </Container>
</BaseLayout>
