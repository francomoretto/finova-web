---
import Container from '@components/common/Container.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Financiación para promotores"
  description="Financiación de promociones inmobiliarias y proyectos de obra nueva. FINOVA acompaña al promotor en la búsqueda de financiación."
  canonical="/financiacion-promotores/"
>
  <Container as="section" class="section">
    <h1>Financiación para promotores</h1>
    <p class="lead">Financiación de promociones inmobiliarias y obra nueva.</p>
    <p class="placeholder-note">
      Contenido pendiente de redacción y diseño. Página creada para fijar la ruta y la estructura
      semántica.
    </p>
  </Container>
</BaseLayout>
