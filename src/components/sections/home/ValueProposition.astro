---
/**
 * Propuesta de valor.
 *
 * Banda azul a sangre con las líneas FINOVA incrustadas en el propio archivo y
 * el texto centrado en blanco, como en la web actual. Es una banda
 * institucional breve: sólo título y párrafo.
 */
import { Image } from 'astro:assets';

import Container from '@components/common/Container.astro';
import bandImage from '@assets/images/home/banda-propuesta-valor.png';
---

<section class="value">
  <div class="value__media">
    <Image
      class="value__image"
      src={bandImage}
      alt=""
      widths={[768, 1200, 1600, 2172]}
      sizes="100vw"
      loading="lazy"
    />
  </div>

  <Container>
    <div class="value__content">
      <h2 class="value__title">Comprar tu vivienda puede ser claro, seguro y sin estrés.</h2>
      <p class="value__text">
        Nos ocupamos de simplificar cada etapa del proceso hipotecario: analizamos tu perfil,
        buscamos alternativas de financiación adecuadas a tu situación, gestionamos la documentación
        y hacemos seguimiento de la operación hasta la firma.
      </p>
    </div>
  </Container>
</section>

<style>
  .value {
    position: relative;
    padding-block: var(--space-9);
    color: var(--color-white);
    background-color: var(--color-surface-dark-alt);
    isolation: isolate;
  }

  .value__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  /* Velo de contraste: en pantallas estrechas el recorte deja a la vista las
     diagonales claras del archivo y el texto blanco perdería legibilidad. */
  .value__media::after {
    position: absolute;
    inset: 0;
    content: '';
    background-color: rgb(23 28 87 / 55%);
  }

  .value__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Móvil: la mitad derecha del archivo es azul limpio. */
    object-position: right center;
  }

  .value__content {
    text-align: center;
  }

  .value__title {
    /* Referencia: una sola línea de ~870px a 1710px de viewport. */
    max-inline-size: 55rem;
    margin-inline: auto;
    color: var(--color-white);
  }

  .value__text {
    /* Referencia: bloque centrado de ~650px. */
    max-inline-size: 41rem;
    margin-block-start: var(--space-5);
    margin-inline: auto;
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-on-dark-muted);
  }

  @media (min-width: 64rem) {
    .value {
      padding-block: var(--space-10);
    }

    /* A partir de aquí se ve el archivo completo: diagonales a la izquierda y
       azul limpio bajo el texto, como en la web actual. */
    .value__image {
      object-position: left center;
    }

    .value__media::after {
      background-color: transparent;
    }
  }
</style>
