---
/**
 * Franja CTA hacia el simulador, entre entidades y contacto.
 *
 * Sin tarjeta: forma parte del flujo de la página. Las líneas FINOVA entran
 * parcialmente por el extremo derecho, recortadas por la propia sección.
 * No contiene lógica de cálculo: sólo enlaza a `/simulador-hipoteca/`.
 */
import BrandLines from '@components/common/BrandLines.astro';
import Button from '@components/common/Button.astro';
import Container from '@components/common/Container.astro';
---

<section class="simulator-cta">
  <BrandLines tone="dark" position="top-end" class="simulator-cta__lines" />

  <Container>
    <div class="simulator-cta__layout">
      <div class="simulator-cta__content">
        <h2 class="simulator-cta__title">Calcula una estimación de tu hipoteca</h2>
        <p class="simulator-cta__text">
          Conoce de forma orientativa la cuota mensual, el capital financiado y la aportación propia
          que podrías necesitar.
        </p>
      </div>

      <div class="simulator-cta__action">
        <Button href="/simulador-hipoteca/" size="large">Simular mi hipoteca</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .simulator-cta {
    position: relative;
    padding-block: var(--section-spacing);
    /* Recorta las líneas que asoman por el borde: nunca desbordan la página. */
    overflow: hidden;
    isolation: isolate;
  }

  /* Decoración: entra parcialmente por la derecha, fuera del texto. */
  .simulator-cta :global(.simulator-cta__lines) {
    inline-size: clamp(3rem, 7vw, 6.5rem);
    opacity: 0.16;
  }

  .simulator-cta__layout {
    display: grid;
    gap: var(--space-7);
  }

  .simulator-cta__title {
    max-inline-size: 20ch;
  }

  .simulator-cta__text {
    max-inline-size: 52ch;
    margin-block-start: var(--space-4);
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
  }

  .simulator-cta__action {
    display: grid;
    justify-items: start;
  }

  @media (min-width: 64rem) {
    .simulator-cta__layout {
      grid-template-columns: 1fr auto;
      gap: var(--space-10);
      align-items: center;
    }

    .simulator-cta :global(.simulator-cta__lines) {
      /* Se aparta del texto y del botón. */
      inset-inline-end: calc(var(--space-4) * -1);
    }
  }
</style>
