---
/**
 * Bloque institucional. Ancla `#sobre-finova`.
 *
 * Reproduce la banda de la web actual: fondo azul a sangre con la fotografía
 * de la vivienda fundida a la derecha y las líneas FINOVA a la izquierda (todo
 * incrustado en el archivo original, 2172×724). El texto ocupa la mitad
 * izquierda: medido, título ~35px a dos líneas y párrafo de ~600px de ancho.
 */
import { Image } from 'astro:assets';

import Container from '@components/common/Container.astro';
import bandImage from '@assets/images/home/banda-institucional.png';
---

<section class="about" id="sobre-finova">
  <div class="about__media">
    <Image
      class="about__image"
      src={bandImage}
      alt=""
      widths={[768, 1200, 1600, 2172]}
      sizes="100vw"
      loading="lazy"
    />
  </div>

  <Container>
    <div class="about__content">
      <h2 class="about__title">Tus intereses,<br />en el centro del proceso</h2>

      <p class="about__text">
        En FINOVA no somos una entidad financiera. Somos un intermediario de crédito inmobiliario y
        trabajamos para ayudarte a encontrar una solución de financiación adecuada a tu perfil y a
        tu proyecto. Te acompañamos para que entiendas las distintas alternativas y puedas tomar una
        decisión informada y con mayor seguridad.
      </p>
    </div>
  </Container>
</section>

<style>
  .about {
    position: relative;
    padding-block: var(--space-10);
    color: var(--color-white);
    background-color: var(--color-surface-dark-alt);
    isolation: isolate;
  }

  .about__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  /* Velo de contraste para pantallas estrechas, donde el recorte acerca la
     fotografía al texto. */
  .about__media::after {
    position: absolute;
    inset: 0;
    content: '';
    background-color: rgb(23 28 87 / 55%);
  }

  .about__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Móvil: se encuadra en la zona azul de la izquierda. */
    object-position: left center;
  }

  .about__title {
    text-wrap: balance;
    color: var(--color-white);
  }

  .about__text {
    /* Referencia: bloque de ~600px a 1710px de viewport. */
    max-inline-size: 38rem;
    margin-block-start: var(--space-6);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-white);
  }

  @media (min-width: 64rem) {
    /* Referencia: banda de ~300px de alto; la altura la marca el contenido. */
    .about {
      display: flex;
      align-items: center;
      padding-block: var(--space-9) var(--space-10);
    }

    /* La fotografía vive en la mitad derecha del archivo: se ancla ahí para
       que el texto se apoye sobre el azul limpio de la izquierda. */
    .about__image {
      object-position: right center;
    }

    .about__media::after {
      background-color: transparent;
    }

    .about__content {
      max-inline-size: 48%;
    }
  }
</style>
