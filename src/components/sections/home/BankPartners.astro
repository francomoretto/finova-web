---
/**
 * Entidades financieras con las que trabaja FINOVA.
 *
 * Datos exclusivamente de `src/data/banks.ts`. Sin carrusel y sin JavaScript.
 *
 * Los logotipos todavía no existen. Cuando lleguen, basta con rellenar el campo
 * `logo` en `banks.ts` y descomentar el bloque marcado más abajo: ni esta
 * sección ni `index.astro` cambian de estructura.
 */
import Container from '@components/common/Container.astro';
import { BANKS } from '@data/banks';
---

<section class="banks section--soft">
  <Container>
    <h2 class="banks__title">Entidades financieras con las que trabajamos</h2>

    <ul class="banks__grid" role="list">
      {
        BANKS.map((bank) => (
          <li class="banks__item">
            {/*
              Cuando exista `bank.logo`, sustituir el <span> por:
                <img src={bank.logo} alt={bank.name} loading="lazy" width="120" height="40" />
            */}
            <span class="banks__name">{bank.name}</span>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .banks {
    padding-block: var(--section-spacing);
  }

  .banks__title {
    max-inline-size: 24ch;
  }

  .banks__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    margin-block-start: var(--space-9);
  }

  .banks__item {
    display: grid;
    place-items: center;
    min-block-size: 5rem;
    padding: var(--space-4);
    text-align: center;
    background-color: var(--color-background);
    border: var(--border-default);
    border-radius: var(--radius-md);
  }

  .banks__name {
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-navy);
  }

  @media (min-width: 48rem) {
    .banks__grid {
      grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
      gap: var(--space-5);
    }
  }
</style>
