---
/**
 * Proceso de trabajo. Ancla `#proceso` (la cabecera enlaza a `/#proceso`).
 *
 * Reproduce la sección de la web actual: título centrado y cuatro columnas
 * centradas, cada una encabezada por un círculo azul de 50px con su número
 * (medidas tomadas de la captura de referencia a 1710px).
 *
 * Móvil: secuencia vertical. Sin slider y sin JavaScript.
 */
import Container from '@components/common/Container.astro';

interface Step {
  readonly number: string;
  readonly title: string;
  readonly text: string;
}

const steps: readonly Step[] = [
  {
    number: '1',
    title: 'Analizamos tu perfil',
    text: 'Revisamos tu situación, necesidades y características de la operación.',
  },
  {
    number: '2',
    title: 'Buscamos las mejores alternativas',
    text: 'Negociamos entre distintas entidades financieras en función de tu perfil y de las características de la operación.',
  },
  {
    number: '3',
    title: 'Gestionamos el proceso',
    text: 'Nos ocupamos de la documentación, tasación y seguimiento de cada etapa.',
  },
  {
    number: '4',
    title: 'Te acompañamos hasta la firma',
    text: 'Seguimos la operación hasta el momento de la firma de tu hipoteca.',
  },
];
---

<section class="process section--soft" id="proceso">
  <Container>
    <h2 class="process__title">Un proceso simple para tomar una gran decisión</h2>

    <ol class="process__list" role="list">
      {
        steps.map((step) => (
          <li class="process__step">
            <p class="process__number" aria-hidden="true">
              {step.number}
            </p>
            <h3 class="process__step-title">{step.title}</h3>
            <p class="process__step-text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .process {
    padding-block: var(--section-spacing);
  }

  .process__title {
    /* Referencia: una sola línea de ~745px. */
    max-inline-size: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  .process__list {
    display: grid;
    gap: var(--space-8);
    padding: 0;
    margin-block-start: var(--space-10);
    list-style: none;
  }

  .process__step {
    text-align: center;
  }

  /* Círculo azul de 50px con el número, como en la web actual. */
  .process__number {
    display: grid;
    place-items: center;
    inline-size: 3.125rem;
    block-size: 3.125rem;
    max-inline-size: none;
    margin-inline: auto;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    color: var(--color-white);
    background-color: var(--color-primary);
    border-radius: var(--radius-pill);
  }

  .process__step-title {
    margin-block-start: var(--space-5);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .process__step-text {
    max-inline-size: 32ch;
    margin-block-start: var(--space-3);
    margin-inline: auto;
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .process__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-9) var(--space-7);
    }
  }

  @media (min-width: 64rem) {
    .process__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-7);
    }
  }
</style>
