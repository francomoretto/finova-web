---
/**
 * Logotipo de FINOVA (isotipo + marca + bajada «Intermediación hipotecaria»).
 *
 * Los archivos reales vienen del material de la web actual. Header y Footer no
 * saben qué archivo concreto existe: toda esa decisión vive aquí.
 *
 * Proporción original 778×329 (2,36:1). El alto se controla con la custom
 * property `--logo-height`, que fija quien lo usa.
 */
import { Image } from 'astro:assets';

import logoDark from '@assets/brand/logo-finova.png';
import logoLight from '@assets/brand/logo-finova-white.png';

interface Props {
  /** `dark` para fondos claros; `light` para fondos oscuros. */
  tone?: 'dark' | 'light';
  /** Nombre accesible. Si se omite, el logo es decorativo (`alt=""`). */
  label?: string;
  /** Carga prioritaria: sólo para el logo de la cabecera. */
  eager?: boolean;
  class?: string;
}

const { tone = 'dark', label, eager = false, class: className }: Props = Astro.props;

const source = tone === 'light' ? logoLight : logoDark;
const classes = ['logo', className].filter(Boolean).join(' ');
---

<Image
  class={classes}
  src={source}
  alt={label ?? ''}
  widths={[160, 240, 320]}
  sizes="200px"
  loading={eager ? 'eager' : 'lazy'}
/>

<style>
  .logo {
    inline-size: auto;
    block-size: var(--logo-height, 3.25rem);
    object-fit: contain;
  }
</style>
