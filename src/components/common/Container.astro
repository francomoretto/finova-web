---
/** Contenedor centrado con el ancho máximo del sistema de diseño. */
interface Props {
  /** Etiqueta HTML a renderizar. Por defecto `div`. */
  as?: 'div' | 'section' | 'article' | 'header' | 'footer' | 'nav' | 'aside';
  /** Usa el ancho reducido para contenido de lectura larga. */
  narrow?: boolean;
  class?: string;
}

const { as: Tag = 'div', narrow = false, class: className }: Props = Astro.props;
const classes = ['container', narrow ? 'container--narrow' : null, className]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes}><slot /></Tag>
