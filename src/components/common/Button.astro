---
/**
 * Botón / enlace de acción de FINOVA.
 *
 * Renderiza `<a>` cuando recibe `href` y `<button>` en caso contrario, para no
 * romper la semántica ni la navegación por teclado.
 *
 * `disabled` sólo aplica a `<button>`: un enlace deshabilitado no existe en
 * HTML; si una acción no está disponible, no se pinta el enlace.
 */
interface Props {
  /** Si se indica, el componente se renderiza como enlace. */
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'default' | 'large';
  /** Sólo como `<button>`. */
  type?: 'button' | 'submit' | 'reset';
  /** Sólo como `<button>`. */
  disabled?: boolean;
  /** Sólo como enlace. Con `_blank` se añade `rel` seguro automáticamente. */
  target?: '_blank' | '_self';
  /** Nombre accesible cuando el texto visible no basta. */
  'aria-label'?: string;
  /** Marca el enlace como página actual. */
  'aria-current'?: 'page';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'default',
  type = 'button',
  disabled = false,
  target,
  'aria-label': ariaLabel,
  'aria-current': ariaCurrent,
  class: className,
}: Props = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
const isLink = typeof href === 'string';
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;
---

{
  isLink ? (
    <a
      class={classes}
      href={href}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      aria-current={ariaCurrent}
    >
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} disabled={disabled} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap-target-min);
    font-family: var(--font-body);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    transition: var(--transition-colors);
  }

  /* --- Tamaños ---------------------------------------------------------- */

  .btn--default {
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-body-sm);
  }

  .btn--large {
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-body);
  }

  /* --- Primary ---------------------------------------------------------- */

  .btn--primary {
    color: var(--color-text-inverse);
    background-color: var(--color-primary);
  }

  .btn--primary:hover {
    color: var(--color-text-inverse);
    background-color: var(--color-primary-hover);
  }

  .btn--primary:active {
    background-color: var(--color-primary-active);
  }

  /* --- Secondary -------------------------------------------------------- */

  .btn--secondary {
    color: var(--color-primary);
    background-color: transparent;
    border-color: var(--color-primary);
  }

  .btn--secondary:hover {
    color: var(--color-text-inverse);
    background-color: var(--color-primary);
  }

  .btn--secondary:active {
    background-color: var(--color-primary-active);
    border-color: var(--color-primary-active);
  }

  /* --- Text ------------------------------------------------------------- */

  .btn--text {
    padding-inline: var(--space-2);
    color: var(--color-primary);
    background-color: transparent;
  }

  .btn--text:hover {
    color: var(--color-petrol);
    background-color: var(--color-background-soft);
  }

  .btn--text:active {
    background-color: var(--color-border);
  }

  /* --- Estados comunes -------------------------------------------------- */

  .btn:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .btn:disabled:hover {
    color: var(--color-text-inverse);
    background-color: var(--color-primary);
  }

  .btn--secondary:disabled:hover,
  .btn--text:disabled:hover {
    color: var(--color-primary);
    background-color: transparent;
  }
</style>
