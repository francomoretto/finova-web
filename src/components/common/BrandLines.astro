---
/**
 * Recurso decorativo de líneas diagonales de FINOVA.
 *
 * Usa los SVG reales de la marca (`public/brand/`). Existen dos tintas:
 *   - `dark`  navy + petróleo, para fondos claros
 *   - `light` blanco + navy, para fondos oscuros
 *
 * Las fotografías de la web actual ya traen las líneas incrustadas; este
 * componente es para las secciones que NO tienen imagen de fondo.
 *
 * Puramente decorativo: `aria-hidden` y sin captura de puntero.
 */
interface Props {
  tone?: 'dark' | 'light';
  /** Esquina donde se ancla el recurso. */
  position?: 'top-end' | 'bottom-start' | 'top-start' | 'bottom-end';
  class?: string;
}

const { tone = 'dark', position = 'top-end', class: className }: Props = Astro.props;
const classes = ['brand-lines', `brand-lines--${position}`, `brand-lines--${tone}`, className]
  .filter(Boolean)
  .join(' ');
---

<div class={classes} aria-hidden="true"></div>

<style>
  .brand-lines {
    position: absolute;
    z-index: -1;
    inline-size: clamp(4.5rem, 8vw, 8rem);
    /* Proporción original del SVG: 95,19 × 236,65. */
    aspect-ratio: 95.19 / 236.65;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    pointer-events: none;
  }

  .brand-lines--dark {
    background-image: url('/brand/finova-lines-dark.svg');
  }

  .brand-lines--light {
    background-image: url('/brand/finova-lines-light.svg');
  }

  .brand-lines--top-end {
    inset-block-start: 0;
    inset-inline-end: 0;
  }

  .brand-lines--top-start {
    inset-block-start: 0;
    inset-inline-start: 0;
  }

  .brand-lines--bottom-start {
    inset-block-end: 0;
    inset-inline-start: 0;
  }

  .brand-lines--bottom-end {
    inset-block-end: 0;
    inset-inline-end: 0;
  }
</style>
