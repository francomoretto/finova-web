---
/**
 * Pie de página de FINOVA.
 *
 * Desktop: 4 columnas · Tablet: 2×2 · Móvil: 1 columna.
 *
 * El fondo es la banda azul de la web actual (2172×724), que ya trae las
 * líneas diagonales de FINOVA incrustadas.
 */
import { Image } from 'astro:assets';

import Container from '@components/common/Container.astro';
import Logo from '@components/common/Logo.astro';
import bandImage from '@assets/images/home/banda-footer.png';
import { COMPANY } from '@data/company';
import { legalNavigation, mainNavigation, serviceNavigation } from '@data/navigation';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__decor">
    <Image
      class="site-footer__decor-image"
      src={bandImage}
      alt=""
      widths={[768, 1200, 1600, 2172]}
      sizes="100vw"
      loading="lazy"
    />
  </div>

  <Container>
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo tone="light" label="FINOVA" />
        <p class="site-footer__claim">Simplificamos decisiones complejas.</p>
      </div>

      <nav class="site-footer__col" aria-label="Navegación del pie de página">
        <h2 class="site-footer__heading">Navegación</h2>
        <ul class="site-footer__list" role="list">
          {
            mainNavigation.map((item) => (
              <li>
                <a class="site-footer__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Servicios">
        <h2 class="site-footer__heading">Servicios</h2>
        <ul class="site-footer__list" role="list">
          {
            serviceNavigation.map((item) => (
              <li>
                <a class="site-footer__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Contacto e información legal</h2>
        <ul class="site-footer__list" role="list">
          <li>
            <a class="site-footer__link" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
          </li>
          {
            legalNavigation.map((item) => (
              <li>
                <a class="site-footer__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__legal">
      <p class="site-footer__regulatory">
        {COMPANY.legalName}<br />
        {
          `Intermediario de Crédito Inmobiliario registrado en el Banco de España · ${COMPANY.registrations.bankOfSpain}`
        }<br />
        {`Asociado ANICI · Nº ${COMPANY.registrations.anici}`}
      </p>
      <p class="site-footer__copyright">
        {`© ${year} ${COMPANY.brand}. Todos los derechos reservados.`}
      </p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: var(--space-11) var(--space-8);
    color: var(--color-white);
    /* Color de respaldo mientras carga la imagen. */
    background-color: var(--color-surface-dark-alt);
    isolation: isolate;
  }

  /* Banda azul de la marca: ya trae las líneas diagonales incrustadas. */
  .site-footer__decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .site-footer__decor-image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: right center;
  }

  /* --- Rejilla ----------------------------------------------------------- */

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9) var(--space-7);
  }

  .site-footer__brand {
    --logo-height: 3.75rem;
  }

  .site-footer__claim {
    max-inline-size: 22ch;
    margin-block-start: var(--space-4);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-snug);
    color: var(--color-white);
  }

  .site-footer__heading {
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-text-on-dark-muted);
  }

  .site-footer__list {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    margin-block-start: var(--space-4);
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target-min);
    font-size: var(--font-size-body-sm);
    color: var(--color-white);
    text-decoration: none;
  }

  .site-footer__link:hover {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-on-dark);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-xs);
  }

  /* --- Franja regulatoria ------------------------------------------------ */

  .site-footer__legal {
    padding-block-start: var(--space-7);
    margin-block-start: var(--space-10);
    border-block-start: var(--border-width) solid var(--color-border-on-dark);
  }

  .site-footer__regulatory,
  .site-footer__copyright {
    max-inline-size: none;
    font-size: var(--font-size-label);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-on-dark-muted);
  }

  .site-footer__copyright {
    margin-block-start: var(--space-5);
  }

  /* --- Tablet: 2×2 ------------------------------------------------------- */

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5) var(--space-7);
      align-items: baseline;
      justify-content: space-between;
    }

    .site-footer__copyright {
      margin-block-start: 0;
    }
  }

  /* --- Desktop: 4 columnas ----------------------------------------------- */

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1.4fr 1.2fr;
      gap: var(--space-7);
    }
  }
</style>
