---
/** Pie de página: datos legales confirmados y navegación secundaria. */
import Container from '@components/common/Container.astro';
import { COMPANY } from '@data/company';
import { SERVICES } from '@data/services';

const year = new Date().getFullYear();

const legalLinks = [
  { href: '/aviso-legal/', label: 'Aviso legal' },
  { href: '/politica-privacidad/', label: 'Política de privacidad' },
  { href: '/politica-cookies/', label: 'Política de cookies' },
];
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__grid">
      <div class="site-footer__block">
        <p class="site-footer__brand">{COMPANY.brand}</p>
        <p class="site-footer__text">{COMPANY.activity}</p>
        <address class="site-footer__address">
          {COMPANY.legalName} · NIF {COMPANY.nif}<br />
          {COMPANY.address.street}<br />
          {COMPANY.address.postalCode}
          {COMPANY.address.city} ({COMPANY.address.region})<br />
          <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
        </address>
      </div>

      <nav class="site-footer__block" aria-label="Servicios">
        <h2 class="site-footer__heading">Servicios</h2>
        <ul role="list" class="site-footer__list">
          {
            SERVICES.map((service) => (
              <li>
                <a href={service.href}>{service.navLabel}</a>
              </li>
            ))
          }
          <li><a href="/simulador-hipoteca/">Simulador de hipoteca</a></li>
        </ul>
      </nav>

      <nav class="site-footer__block" aria-label="Información legal">
        <h2 class="site-footer__heading">Legal</h2>
        <ul role="list" class="site-footer__list">
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="site-footer__legal">
      Intermediario de Crédito Inmobiliario inscrito en el Registro del Banco de España con el
      número {COMPANY.registrations.bankOfSpain}. Asociado ANICI nº {COMPANY.registrations.anici}.
    </p>

    <p class="site-footer__copyright">
      © {year}
      {COMPANY.legalName}. Todos los derechos reservados.
    </p>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
    margin-block-start: var(--section-spacing);
    background-color: var(--color-background-soft);
    border-block-start: var(--border-default);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .site-footer__brand {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-navy);
  }

  .site-footer__text,
  .site-footer__address {
    font-size: var(--font-size-sm);
    font-style: normal;
    color: var(--color-text-muted);
  }

  .site-footer__address {
    margin-block-start: var(--space-3);
    line-height: var(--line-height-relaxed);
  }

  .site-footer__heading {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .site-footer__list {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    font-size: var(--font-size-sm);
  }

  .site-footer__legal,
  .site-footer__copyright {
    max-inline-size: none;
    margin-block-start: var(--space-6);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .site-footer__copyright {
    margin-block-start: var(--space-2);
  }
</style>
